{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build training-image with BitBake",
            "type": "bitbake",
            "recipes": [
                "training-image"
            ]
        },
        {
            "label": "Build training-image-debug with BitBake ",
            "type": "bitbake",
            "recipes": [
                "training-image-debug"
            ]
        },
        {
            "label": "Build for Avenger96 with KAS (Debug Configuration, all enabled Image Variants)",
            "type": "shell",
            "command": "kas build config/avenger96.yml:config/debug.yml"
        },
        {
            "label": "Clean Avenger96 Build with KAS",
            "type": "shell",
            "command": "kas clean config/avenger96.yml:config/debug.yml"
        },
        {
            "label": "Build for QEMU64 with KAS (Debug Configuration, all enabled Image Variants)",
            "type": "shell",
            "command": "kas build config/emu.yml:config/debug.yml"
        },
        {
            "label": "Clean QEMU64 Build with KAS",
            "type": "shell",
            "command": "kas clean config/emu.yml:config/debug.yml"
        },
        {
            "label": "Run QEMU64 emulator with training-image (Previous Build Required!)",
            "type": "shell",
            "command": "kas shell config/emu.yml:config/debug.yml -c 'runqemu nographic slirp snapshot training-image'"
        }
    ]
}